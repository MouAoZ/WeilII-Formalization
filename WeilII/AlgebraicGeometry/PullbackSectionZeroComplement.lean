module

public import WeilConjectures.AlgebraicGeometry.Modules.ZeroLocus
public import WeilConjectures.Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.OfAmple

/-! # Pulling back the nonvanishing locus of a line bundle section -/

namespace WeilII

open AlgebraicGeometry CategoryTheory Scheme.Modules

universe u

/-- On an affine test scheme where a pulled-back section is `r` times a free generator,
its nonvanishing locus is the principal open `D(r)`. The zero scheme commutes with
pullback, and in the specified frame its ideal is generated by `r`. This applies the
local coefficient description of the zero scheme to the whole affine test scheme. -/
public theorem preimage_zeroLocus_openComplement_eq_basicOpen {P Y : Scheme.{u}} [IsAffine Y] (h : Y ⟶ P)
    {M : P.Modules} [M.IsInvertible] (s : Γ(M, ⊤))
    {e : Γ((pullback h).obj M, ⊤)} (he : IsFreeGenerator e) {r : Γ(Y, ⊤)}
    (hr : pullbackSection h s = r • e) :
    h ⁻¹ᵁ (homOfGlobalSection M s).zeroLocus.subschemeι.openComplement = Y.basicOpen r := by
  have := IsInvertible.sheafOfModules_isInvertible M
  have := IsInvertible.sheafOfModules_isInvertible ((pullback h).obj M)
  let σ := homOfGlobalSection M s
  let τ := (pullbackObjUnitIso h).inv ≫ (pullback h).map σ
  have ho : σ.zeroLocus.subschemeι.openComplement = σ.zeroLocus.support.compl := by
    ext x
    simp only [Scheme.Hom.coe_openComplement, Scheme.IdealSheafData.range_subschemeι]
    rfl
  change h ⁻¹ᵁ σ.zeroLocus.subschemeι.openComplement = _
  rw [ho, ← compl_support_zeroLocus_pullback h σ]
  have eqn := basicOpen_coeff_eq τ ⟨⊤, isAffineOpen_top Y⟩ he
  have hs : σ.app ⊤ (1 : Γ(P, ⊤)) = s := by
    simp only [σ, homOfGlobalSection_app_one, Scheme.Modules.presheaf_map_id_apply]
  have ht : τ.app ⊤ (1 : Γ(Y, ⊤)) = r • e :=
    (pullbackSection_app_one h σ).symm.trans ((congrArg (pullbackSection h) hs).trans hr)
  change Y.basicOpen (he.coeff (τ.app ⊤ (unitSectionsEquiv _ 1))) = ⊤ ⊓ _ at eqn
  rw [show τ.app ⊤ (unitSectionsEquiv _ 1) = r • e from ht, he.coeff_smul_self, top_inf_eq] at eqn
  exact eqn.symm


end WeilII
