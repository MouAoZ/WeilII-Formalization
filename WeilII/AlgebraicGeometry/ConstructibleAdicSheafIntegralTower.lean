/-!
# The integral tower of a constructible geometric adic sheaf

SGA 4½, *Rapport sur la formule des traces*, §§2.1, 2.5, 2.8–2.11, pp. 82–85.
-/

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry.ProEtale
open scoped CategoryTheory.Obj

namespace WeilII

universe u

/-- A constructible geometric adic sheaf has a torsion-free integral model over one finite
coefficient field. Its quotients by all positive powers of a uniformizer descend to constructible
étale sheaves with epimorphic transitions. The quotient projections exhibit the model as their
pro-étale inverse limit. Index `n` denotes exponent `n + 1`. The transition maps are linear after
restriction of scalars to the common ring of integers. The comparisons on abelian sheaves commute
with each integral scalar, so the finite-level comparisons are linear over the quotient rings.

Proof. The scheme is noetherian. Pass to the condensed module of the given sheaf and descend it
to a single finite extension E. On a constructible stratification the resulting E-sheaf is
locally finitely presented. Choose integral models on the strata and apply integral model gluing
to get a constructible integral sheaf N on the whole scheme. Quotient N by the union of the
kernels of powers of the uniformizer. A local lift of a class killed by the uniformizer belongs
locally to that union, so the quotient M is torsion-free. Inverting the uniformizer kills the
union and gives back the original rationalization. On a trivializing cover of each stratum, the
elementary divisor decomposition of N identifies M with its finite free summand.

The quotient of the continuous coefficient sheaf modulo a uniformizer power is the finite
discrete coefficient sheaf. Continuous maps to that finite quotient lift using representatives.
Thus each quotient of M is constructible with finite coefficients and descends to the étale
site. Full faithfulness of comparison descends the quotient transitions and their scalar
linearity. Comparison preserves cokernels and reflects zero objects, hence these transitions
are epimorphisms. The descended projections have the indicated cokernel property.

Finally M in degree zero is bounded constructible and derived complete. In the canonical
reduction triangle multiplication by ℓⁱ is injective on M, so the derived reduction is the
ordinary quotient in degree zero, with its quotient projection. Apply Hom from a sheaf in
degree zero to the homotopy limit triangle of these reductions. Negative Ext into each
quotient vanishes, so Hom into M is the kernel of one minus the transition shift on the
product of the Hom groups. This is the ordinary limit property, also after forgetting the
module action, since the forgetful functor creates limits. For ramification index e, the
ideals generated by ℓ^i and π^(e·i) agree. Projection from higher levels uniquely extends
every compatible family on the cofinal levels e·i to all positive levels.

See SGA 4½, *Rapport*, §§2.1, 2.5, 2.8–2.11, and the finite-field descent and integral
gluing in `CondensedFinitePresentationDescent` and `ContinuousConstructibleIntegralGluing`. -/
public theorem exists_constructibleAdicSheaf_integralTower
    (k₀ : Type u) [Field k₀] [Finite k₀] (ℓ : ℕ) [Fact ℓ.Prime] [Fact (ringChar k₀ ≠ ℓ)]
    {Z : Scheme.{u}} (a : Z ⟶ Spec (.of (AlgebraicClosure k₀)))
    [IsSeparated a] [LocallyOfFiniteType a] [QuasiCompact a]
    (F : AdicSheaf ℓ Z) (hF : IsAdicConstructibleSheaf F) :
    ∃ (E : PadicAlgCl.FiniteIntermediateField ℓ) (π : PadicAlgCl.integers ℓ E.1),
      IsLocalRing.maximalIdeal (PadicAlgCl.integers ℓ E.1) = Ideal.span {π} ∧
      ∃ M : Mod (Sheaf (Scheme.ProEt.topology Z) Ab.{u + 1})
          (condensedRingObj (Profinite.padicIntegersRingObj ℓ E.1) Z),
        IsConstructibleModuleObject _ M ∧ Mono ((padicIntegersCenter Z ℓ E.1 π).app M) ∧
        Nonempty ((Mod.extendScalars (padicIntegersToPadicSubfield Z ℓ E) ⋙
          Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl Z ℓ E)).obj M ≅
          (adicSheafEquivCondensedMod ℓ Z).functor.obj F) ∧
        let I := fun n : ℕ ↦ Ideal.span {π ^ (n + 1)}
        ∃ T : (n : ℕ) → Sheaf Z.smallEtaleTopology
            (ModuleCat.{u + 1} (ULift.{u + 1} (PadicAlgCl.integers ℓ E.1 ⧸ I n))),
          (∀ n, Scheme.IsConstructibleSheaf (T n)) ∧
          let R := ULift.{u + 1} (PadicAlgCl.integers ℓ E.1)
          let integralLevels := fun n ↦ (Sheaf.restrictScalars Z.smallEtaleTopology
            (Ideal.Quotient.mk (I n)).ulift).obj (T n)
          ∃ t : (n : ℕ) → integralLevels (n + 1) ⟶ integralLevels n,
            (∀ n, Epi (t n)) ∧
            let tower := Functor.ofOpSequence t ⋙ comparisonUpperStar (ModuleCat.{u + 1} R) Z
            let forgetScalars := sheafCompose (Scheme.ProEt.topology Z)
              (forget₂ (ModuleCat.{u + 1} R) Ab)
            ∃ p : (Functor.const ℕᵒᵖ).obj M.X ⟶ tower ⋙ forgetScalars,
              Nonempty (IsLimit (Cone.mk M.X p)) ∧
              ∀ n : ℕ,
                (∀ r : R, ((padicIntegersCenter Z ℓ E.1 r.down).app M).hom ≫ p.app (op n) =
                  p.app (op n) ≫ forgetScalars.map (Sheaf.smulEnd (tower.obj (op n)) r)) ∧
                ∃ w : ((padicIntegersCenter Z ℓ E.1 (π ^ (n + 1))).app M).hom ≫ p.app (op n) = 0,
                  Nonempty (IsColimit (CokernelCofork.ofπ (p.app (op n)) w)) := by
  classical
  have : IsNoetherian Z := isNoetherian_of_locallyOfFiniteType a
  let model := exists_constructibleAdicSheaf_integralModel ℓ F hF
  let E : PadicAlgCl.FiniteIntermediateField ℓ := model.choose
  let N := model.choose_spec.choose
  have hN := model.choose_spec.choose_spec.1
  have eN := model.choose_spec.choose_spec.2.some
  let m := IsLocalRing.maximalIdeal (PadicAlgCl.integers ℓ E.1)
  have : m.IsPrincipal := PadicAlgCl.isPrincipal_maximalIdeal_integers ℓ E.1
  let π := Submodule.IsPrincipal.generator m
  have hπ : m = Ideal.span {π} := (Ideal.span_singleton_generator m).symm
  let f := padicIntegersToPadicSubfield Z ℓ E
  let η := (Mod.extendRestrictAdjunction f).unit.app N
  let M := image η
  have hM := isConstructible_image_integralLocalizationUnit ℓ E π hπ N hN
  have hm := mono_uniformizer_of_mono_into_restrictedFieldModule ℓ Z E π hπ
    ((Mod.extendScalars f).obj N) (image.ι η)
  refine ⟨E, π, hπ, M, hM, hm, ?_, ?_⟩
  · have := isIso_map_factorThruImage_localizationUnit (Mod.extendRestrictAdjunction f) N
    exact ⟨(Mod.extendScalars (padicSubfieldRingObjToPadicAlgCl Z ℓ E)).mapIso
      (asIso ((Mod.extendScalars f).map (factorThruImage η))).symm ≪≫ eN⟩
  · let level (n : ℕ) := exists_constructibleIntegralEtaleQuotient ℓ E π hπ M hM n
    let T (n : ℕ) := (level n).choose
    let I (n : ℕ) := Ideal.span {π ^ (n + 1)}
    let R := ULift.{u + 1} (PadicAlgCl.integers ℓ E.1)
    let A (n : ℕ) := (Sheaf.restrictScalars Z.smallEtaleTopology
      (Ideal.Quotient.mk (I n)).ulift).obj (T n)
    let V := comparisonUpperStar (ModuleCat.{u + 1} R) Z
    let U := sheafCompose (Scheme.ProEt.topology Z) (forget₂ (ModuleCat.{u + 1} R) Ab)
    let q (n : ℕ) : M.X ⟶ U.obj (V.obj (A n)) := (level n).choose_spec.2.choose
    let sq (n : ℕ) := (level n).choose_spec.2.choose_spec
    let s (r : R) := ((padicIntegersCenter Z ℓ E.1 r.down).app M).hom
    let d (n : ℕ) := ((padicIntegersCenter Z ℓ E.1 (π ^ (n + 1))).app M).hom
    have hw (n : ℕ) : d (n + 1) ≫ q n = 0 := by
      apply (sq n).2.1
      exact Ideal.mem_span_singleton.mpr (pow_dvd_pow π (Nat.le_succ (n + 1)))
    let transitions := exists_compatibleSheafCokernelTower V A M.X s d q
      (fun n ↦ (sq n).1) (fun n ↦ (sq n).2.2.choose) (fun n ↦ (sq n).2.2.choose_spec) hw
    let t := transitions.choose
    let p := transitions.choose_spec.2.choose
    have hp (n : ℕ) : p.app (op n) = q n := transitions.choose_spec.2.choose_spec n
    have coker (n : ℕ) : ∃ w : d n ≫ p.app (op n) = 0,
        Nonempty (IsColimit (CokernelCofork.ofπ (p.app (op n)) w)) := by
      exact (congrArg (fun x : M.X ⟶ U.obj (V.obj (A n)) ↦
        ∃ w : d n ≫ x = 0, Nonempty (IsColimit (CokernelCofork.ofπ x w))) (hp n)).mpr (sq n).2.2
    refine ⟨T, fun n ↦ (level n).choose_spec.1, t, transitions.choose_spec.1, p,
      isLimit_constructibleIntegralQuotientCone ℓ E π hπ M hM hm p coker, fun n ↦ ⟨?_, coker n⟩⟩
    exact (congrArg (fun x : M.X ⟶ U.obj (V.obj (A n)) ↦
      ∀ r : R, s r ≫ x = x ≫ U.map (Sheaf.smulEnd (V.obj (A n)) r)) (hp n)).mpr (sq n).1

end WeilII
