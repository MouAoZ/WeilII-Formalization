module

public import WeilConjectures.AlgebraicGeometry.CoherentReduction.FiniteCoefficientSystemEvaluation
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.DerivedComplete.LiftMorphisms
public import WeilConjectures.SixFunctors.ProEtale.ModuleObject.FiniteComparison.Scalars
public import WeilConjectures.NumberTheory.Padics.IntegersAlgebra

/-!
# Comparing the two integral coefficient reductions

Zhang uses ℓ-adic coefficients on page 2 before (†). This comparison relates the two
presentations in the pinned WeilConjectures modules `CoherentIntegralReduction` and
`ModuleObject.Colimit.IntegralReduction`.
-/

open AlgebraicGeometry AlgebraicGeometry.ProEtale CategoryTheory
open AlgebraicGeometry.ProEtale.CoherentReduction
open scoped CategoryTheory.Obj CategoryTheory.Functor

namespace WeilII

universe u

/-- Postcompose a continuous function on a profinite test object with the coefficient map, then
apply the sheafification unit of `CoherentReduction.continuousPresheaf`. The source uses the
lifted sections of `Profinite.continuousMapRingPresheaf` from WeilConjectures. -/
@[expose] public noncomputable def coherentCoefficientPointMap {T : Type} {S : Type (u + 1)}
    [CommRing T] [TopologicalSpace T] [IsTopologicalRing T]
    [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
    (f : T →+* S) (hf : Continuous f) :
    Profinite.continuousMapRingSheaf.{u} T ⟶
      (sheafCompose _ (forget₂ CommRingCat.{u + 1} RingCat.{u + 1})).obj (continuousPoint S) := by
  let changeRing := forget₂ CommRingCat.{u + 1} RingCat.{u + 1}
  let post : Profinite.continuousMapRingPresheaf.{u} T ⟶ continuousPresheaf S ⋙ changeRing :=
    { app := fun U ↦ RingCat.ofHom ((f.compLeftContinuous U.unop hf).comp ULift.ringEquiv.toRingHom)
      naturality := fun _ _ _ ↦ rfl }
  exact ⟨post ≫ Functor.whiskerRight (toSheafify _ (continuousPresheaf S)) changeRing⟩

/-- Lifting ℚℓ identifies its integral coefficients and all positive-power quotients in the
internal and coherent models. Both reductions and adjacent transitions commute on internal
rings and section rings. The finite comparison carries the specified constant-sheaf map to the
one used by `CoherentReduction.finiteConstantIso`.

Proof. The norm of a base-field scalar in the algebraic closure is its ℓ-adic norm. Its
spectral norm in the lifted field has the same value by `spectralNorm_extends`. Thus lift and
descent restrict to mutually inverse ring maps on the closed unit balls. Applying the norm
identities to differences gives continuity in both directions. The integral isomorphism takes
the ideal generated by ℓ^(n+1) onto the corresponding ideal. The induced quotient isomorphism
sends the class of x to the class of its lift. On representatives both adjacent transitions
give the lower class of that lift, and every quotient element has a representative.

On a profinite test U, postcomposition with either coefficient isomorphism takes a lifted
continuous function to a continuous function with the larger coefficient type. Postcomposition
with its inverse, followed by universe lift, gives the inverse. These maps preserve the ring
operations pointwise and commute with restriction. The small continuous presheaf is a sheaf,
so the large presheaf is a sheaf by transport of unique gluing across this isomorphism, checked
on underlying sets. Its sheafification unit is therefore invertible. The composite is precisely
`coherentCoefficientPointMap`. The representative formulas give the reduction and transition
squares pointwise, and naturality of the unit gives the squares after sheafification.

Forget to abelian sheaves and apply the monoidal pullback from the point. This preserves the
isomorphisms, units, multiplications and commutative squares. Reading the resulting maps on
section rings gives the stated coherent coefficient and transition maps by definition. At the
point the comparison takes a constant function with value b to the unit applied to the
constant function with the lifted residue value. By naturality of the sheafification unit
this is the image under `pointConstants`. Pulling back and using naturality of
`constantSchemeIso` identifies the two constant-sheaf maps on every constant generator.
Sheafification adjunction gives their equality. The characterization of `constantSections`
identifies the resulting section map with the hom of `finiteConstantIso`.

Sources: WeilConjectures, `NumberTheory.Padics.Extension`, `RingObjects.Condensed.IntegersModPow`,
`ModuleObject.FiniteComparison.Scalars`, and `CoherentReduction.CoherentIntegralReduction`. -/
public theorem exists_coherentIntegralQuotientComparison (ℓ : ℕ) [Fact ℓ.Prime] (V : Scheme.{u}) :
    let E := ULift.{u + 1} ℚ_[ℓ]
    let A := PadicAlgCl.integers ℓ ℚ_[ℓ]
    let A' := Padic.coefficientExtensionIntegers ℓ E
    let B := fun n : ℕ ↦ PadicAlgCl.integersModPow ℓ ℚ_[ℓ] (n + 1)
    let B' := fun n : ℕ ↦ Etale.FiniteProperQuotient.Ring ℓ E n
    letI : TopologicalSpace A := TopologicalSpace.induced Subtype.val
      (PadicAlgCl.normedFieldOfAlgebra ℓ ℚ_[ℓ]).toUniformSpace.toTopologicalSpace
    letI : IsTopologicalRing A := PadicAlgCl.isTopologicalRing_integers ℓ ℚ_[ℓ]
    ∃ (e : A ≃+* A') (he : Continuous e), Continuous e.symm ∧
      (∀ x : A, (e x).val = ULift.up x.val) ∧
      ∃ d : (n : ℕ) → ULift.{u + 1} (B n) ≃+* B' n,
        (∀ n x, d n (ULift.up (PadicAlgCl.integersModPowMk ℓ ℚ_[ℓ] (n + 1) x)) =
          quotient ℓ E n (e x)) ∧
        (∀ n b, d n (ULift.up (PadicAlgCl.integersModPowTransition ℓ ℚ_[ℓ] (n + 1) b)) =
          Etale.FiniteProperQuotient.quotient ℓ E n.le_succ (d (n + 1) (ULift.up b))) ∧
        let forgetComm := sheafCompose (coherentTopology Profinite.{u})
          (forget₂ CommRingCat.{u + 1} RingCat.{u + 1})
        let forgetRing := sheafCompose (coherentTopology Profinite.{u}) (forget₂ RingCat.{u + 1} Ab)
        let pull := upperStarFromPoint V
        let a : condensedRingObj (Profinite.padicIntegersRingObj ℓ ℚ_[ℓ]) V ⟶ internalRing V A' :=
          pull.map (forgetRing.map (coherentCoefficientPointMap e.toRingHom he))
        let b (n : ℕ) : condensedRingObj (Profinite.integersModPowRingObj ℓ ℚ_[ℓ] (n + 1)) V ⟶
            internalRing V (B' n) :=
          pull.map (forgetRing.map (coherentCoefficientPointMap
            ((d n).toRingHom.comp ULift.ringEquiv.symm.toRingHom) continuous_of_discreteTopology))
        IsIso a ∧ ∀ n : ℕ, IsIso (b n) ∧
          integersModPowReduction V ℓ ℚ_[ℓ] (n + 1) ≫ b n =
            a ≫ pull.map (forgetRing.map (forgetComm.map (continuousPointMap (quotient ℓ E n)
              (quotient_continuous ℓ E n)))) ∧
          integersModPowTransition V ℓ ℚ_[ℓ] (n + 1) ≫ b n =
            b (n + 1) ≫ pull.map (forgetRing.map (forgetComm.map (continuousPointMap
              (Etale.FiniteProperQuotient.quotient ℓ E n.le_succ) continuous_of_discreteTopology))) ∧
          internalSectionMap V (integersModPowReduction V ℓ ℚ_[ℓ] (n + 1)) ≫
              internalSectionMap V (b n) =
            internalSectionMap V a ≫ CoherentReduction.coefficientMap ℓ E V n ∧
          internalSectionMap V (integersModPowTransition V ℓ ℚ_[ℓ] (n + 1)) ≫
              internalSectionMap V (b n) =
            internalSectionMap V (b (n + 1)) ≫ transitions ℓ E V n ∧
          constRingSheafToCondensedRingObj V (B n) ≫ b n =
            (constantSheaf (Scheme.ProEt.topology V) Ab.{u + 1}).map
              (AddCommGrpCat.ofHom (d n).toRingHom.toAddMonoidHom) ≫ schemeConstants V (B' n) := by
  classical
  intro E A A' B B'
  let : TopologicalSpace A := TopologicalSpace.induced Subtype.val
    (PadicAlgCl.normedFieldOfAlgebra ℓ ℚ_[ℓ]).toUniformSpace.toTopologicalSpace
  let : IsTopologicalRing A := PadicAlgCl.isTopologicalRing_integers ℓ ℚ_[ℓ]
  have normUp (x : ℚ_[ℓ]) :
      spectralNorm ℚ_[ℓ] E (ULift.up x) = ‖algebraMap ℚ_[ℓ] (PadicAlgCl ℓ) x‖ :=
    (spectralNorm_extends (K := ℚ_[ℓ]) (L := E) x).trans (PadicAlgCl.norm_extends ℓ x).symm
  let e : A ≃+* A' := ULift.ringEquiv.symm.restrict (PadicAlgCl.integers ℓ ℚ_[ℓ]).toSubring
      (Padic.coefficientExtensionIntegers ℓ E) fun x ↦ by
    change (‖algebraMap ℚ_[ℓ] (PadicAlgCl ℓ) x‖ ≤ 1) ↔ spectralNorm ℚ_[ℓ] E (ULift.up x) ≤ 1
    rw [normUp]
  have hi := @Isometry.of_dist_eq ℚ_[ℓ] E
    (PadicAlgCl.normedFieldOfAlgebra ℓ ℚ_[ℓ]).toPseudoMetricSpace
    (spectralNorm.normedField ℚ_[ℓ] E).toPseudoMetricSpace ULift.up fun x y ↦ by
      change spectralNorm ℚ_[ℓ] E (ULift.up (x - y)) =
        ‖algebraMap ℚ_[ℓ] (PadicAlgCl ℓ) x - algebraMap ℚ_[ℓ] (PadicAlgCl ℓ) y‖
      rw [normUp, map_sub]
  let : PseudoEMetricSpace ℚ_[ℓ] :=
    (PadicAlgCl.normedFieldOfAlgebra ℓ ℚ_[ℓ]).toPseudoMetricSpace.toPseudoEMetricSpace
  let : PseudoEMetricSpace E :=
    (spectralNorm.normedField ℚ_[ℓ] E).toPseudoMetricSpace.toPseudoEMetricSpace
  let : TopologicalSpace ℚ_[ℓ] :=
    (PadicAlgCl.normedFieldOfAlgebra ℓ ℚ_[ℓ]).toUniformSpace.toTopologicalSpace
  let : TopologicalSpace E := (spectralNorm.normedField ℚ_[ℓ] E).toUniformSpace.toTopologicalSpace
  have he : Continuous e := (hi.continuous.comp continuous_subtype_val).subtype_mk _
  have hei : Continuous e.symm :=
    ((hi.right_inv (g := ULift.down) fun _ ↦ rfl).continuous.comp continuous_subtype_val).subtype_mk _
  refine ⟨e, he, hei, fun _ ↦ rfl, ?_⟩
  let I (n : ℕ) := Ideal.span {(ℓ : A) ^ (n + 1)}
  let I' (n : ℕ) := Ideal.span {(ℓ : A') ^ (n + 1)}
  have mapIdeal (n : ℕ) : I' n = (I n).map e.toRingHom := by simp [I, I', Ideal.map_span]
  let liftQuot (n : ℕ) : B n ≃+* B' n := Ideal.quotientEquiv (I n) (I' n) e (mapIdeal n)
  let d (n : ℕ) : ULift.{u + 1} (B n) ≃+* B' n := ULift.ringEquiv.trans (liftQuot n)
  have transition (n : ℕ) (b : B (n + 1)) :
      liftQuot n (PadicAlgCl.integersModPowTransition ℓ ℚ_[ℓ] (n + 1) b) =
        Etale.FiniteProperQuotient.quotient ℓ E n.le_succ (liftQuot (n + 1) b) := by
    obtain ⟨x, rfl⟩ := PadicAlgCl.integersModPowMk_surjective ℓ ℚ_[ℓ] (n + 2) b
    rfl
  refine ⟨d, fun n x ↦ Ideal.quotientEquiv_mk (I n) (I' n) e (mapIdeal n) x, transition, ?_⟩
  intro forgetComm forgetRing pull a b
  have pointIso {T : Type} {S : Type (u + 1)} [CommRing T] [CommRing S]
      [TopologicalSpace T] [TopologicalSpace S] [IsTopologicalRing T] [IsTopologicalRing S]
      (f : T ≃+* S) (hf : Continuous f) (hg : Continuous f.symm) :
      IsIso (coherentCoefficientPointMap.{u} f.toRingHom hf) := by
    let J := coherentTopology Profinite.{u}
    let F := forget₂ CommRingCat.{u + 1} RingCat.{u + 1}
    let ψ : Profinite.continuousMapRingPresheaf.{u} T ≅ continuousPresheaf S ⋙ F :=
      NatIso.ofComponents (fun U ↦
        (ULift.ringEquiv.trans
          ({ f.toRingHom.compLeftContinuous U.unop hf with
             invFun := f.symm.toRingHom.compLeftContinuous U.unop hg
             left_inv g := ContinuousMap.ext fun x ↦ f.symm_apply_apply (g x)
             right_inv g := ContinuousMap.ext fun x ↦ f.apply_symm_apply (g x) } :
              C(U.unop, T) ≃+* C(U.unop, S))).toRingCatIso) fun _ ↦ rfl
    have hS : Presheaf.IsSheaf J (continuousPresheaf S) := by
      rw [Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget CommRingCat.{u + 1})]
      exact (Presheaf.isSheaf_of_iso_iff (Functor.isoWhiskerRight ψ (forget RingCat))).mp
        ((Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget RingCat.{u + 1})).mp
          (Profinite.isSheaf_continuousMapRingPresheaf T))
    have := isIso_toSheafify J hS
    have : IsIso ((sheafToPresheaf J RingCat).map (coherentCoefficientPointMap f.toRingHom hf)) :=
      inferInstanceAs (IsIso (ψ.hom ≫ Functor.whiskerRight (toSheafify J (continuousPresheaf S)) F))
    exact isIso_of_reflects_iso _ (sheafToPresheaf J RingCat)
  have pointSquare {T U : Type} {S W : Type (u + 1)}
      [CommRing T] [CommRing U] [CommRing S] [CommRing W]
      [TopologicalSpace T] [TopologicalSpace U] [TopologicalSpace S] [TopologicalSpace W]
      [IsTopologicalRing T] [IsTopologicalRing U] [IsTopologicalRing S] [IsTopologicalRing W]
      (p : T →+* U) (hp : Continuous p) (q : S →+* W) (hq : Continuous q)
      (f : T →+* S) (hf : Continuous f) (g : U →+* W) (hg : Continuous g)
      (h : ∀ x, g (p x) = q (f x)) :
      Profinite.continuousMapRingSheafMap.{u} p hp ≫ coherentCoefficientPointMap g hg =
        coherentCoefficientPointMap f hf ≫ forgetComm.map (continuousPointMap q hq) := by
    let ψ : continuousPresheaf S ⟶ continuousPresheaf W :=
      { app := fun X ↦ CommRingCat.ofHom (q.compLeftContinuous X.unop hq)
        naturality := fun _ _ _ ↦ rfl }
    ext X x
    have hn := ConcreteCategory.congr_hom
      (congr_app (toSheafify_naturality (coherentTopology Profinite.{u}) ψ) X)
      (f.compLeftContinuous X.unop hf x.down)
    refine Eq.trans ?_ hn
    apply congrArg ((toSheafify _ (continuousPresheaf W)).app X)
    exact ContinuousMap.ext fun y ↦ h (x.down y)
  have := pointIso e he hei
  refine ⟨Functor.map_isIso _ _, fun n ↦ ?_⟩
  have := pointIso (liftQuot n) continuous_of_discreteTopology continuous_of_discreteTopology
  refine ⟨Functor.map_isIso (forgetRing ⋙ pull) (coherentCoefficientPointMap
    (liftQuot n).toRingHom continuous_of_discreteTopology), ?_⟩
  let Q := quotient ℓ E n
  let τ := Etale.FiniteProperQuotient.quotient ℓ E n.le_succ
  let red := PadicAlgCl.integersModPowMk ℓ ℚ_[ℓ] (n + 1)
  let step := PadicAlgCl.integersModPowTransition ℓ ℚ_[ℓ] (n + 1)
  let G := forgetRing ⋙ pull
  have hred := pointSquare red (PadicAlgCl.continuous_integersModPowMk ℓ ℚ_[ℓ] (n + 1)) Q
    (quotient_continuous ℓ E n) e he (liftQuot n) continuous_of_discreteTopology (fun _ ↦ rfl)
  have hstep := pointSquare step continuous_of_discreteTopology τ continuous_of_discreteTopology
    (liftQuot (n + 1)) continuous_of_discreteTopology (liftQuot n) continuous_of_discreteTopology
    (transition n)
  have hs := congrArg G.map hred
  have ht := congrArg G.map hstep
  rw [G.map_comp, G.map_comp] at hs ht
  refine ⟨hs, ht, ?_, ?_, ?_⟩
  · change internalSectionMap V _ ≫ internalSectionMap V _ =
      internalSectionMap V _ ≫ internalSectionMap V _
    simp only [internalSectionMap_comp]
    congr 1
  · change internalSectionMap V _ ≫ internalSectionMap V _ =
      internalSectionMap V _ ≫ internalSectionMap V _
    simp only [internalSectionMap_comp]
    congr 1
  · set_option backward.isDefEq.respectTransparency false in
    let J := Scheme.ProEt.topology V
    let K := coherentTopology Profinite.{u}
    let C := constantSheaf J Ab.{u + 1}
    let D := constantSheaf K Ab.{u + 1}
    let R := ULift.{u + 1} (B n)
    let S := B' n
    let F := forget₂ CommRingCat.{u + 1} RingCat.{u + 1} ⋙ forget₂ RingCat.{u + 1} Ab.{u + 1}
    let : K.PreservesSheafification F := GrothendieckTopology.instPreservesSheafification _ _
    let φ := AddCommGrpCat.ofHom (d n).toRingHom.toAddMonoidHom
    let j := (constantSchemeIso V).hom
    let c := Profinite.constRingSheafToContinuousMapRingObj.{u} (B n)
    let k := forgetRing.map (coherentCoefficientPointMap (liftQuot n).toRingHom
      continuous_of_discreteTopology)
    let m := ((constantCommuteCompose K F).app (CommRingCat.of S)).inv
    let p := forgetRing.map (forgetComm.map (pointConstants S))
    have hfac : constRingSheafToCondensedRingObj V (B n) =
        j.app (AddCommGrpCat.of R) ≫ pull.map c := by
      have hs (x : R) :
          Sheaf.constRingSheafSection J x ≫ constRingSheafToCondensedRingObj V (B n) =
            Sheaf.constRingSheafSection J x ≫ j.app _ ≫ pull.map c := by
        rw [constRingSheafSection_comp_constRingSheafToCondensedRingObj V (B n) x.down]
        have hj := NatTrans.IsMonoidal.ε_comp_map_comp_app j
          (AddCommGrpCat.unitHom (M := AddCommGrpCat.of R) x)
        change Sheaf.constRingSheafSection J x ≫ j.app _ =
          (Functor.LaxMonoidal.ε pull ≫ pull.map (Functor.LaxMonoidal.ε D)) ≫
            pull.map (D.map (AddCommGrpCat.unitHom (M := AddCommGrpCat.of R) x)) at hj
        rw [← Category.assoc, hj]
        simp only [Category.assoc, ← pull.map_comp]
        exact congrArg (fun f ↦ Functor.LaxMonoidal.ε pull ≫ pull.map f)
          (Profinite.constRingSheafSection_comp_constRingSheafToContinuousMapRingObj
            (B n) x.down).symm
      apply Sheaf.hom_ext
      apply sheafify_hom_ext J _ _ (condensedRingObj (Profinite.continuousMapRingObj (B n)) V).property
      ext U x
      let I := sheafToPresheaf J Ab.{u + 1}
      have h := congrArg (fun f ↦ Functor.LaxMonoidal.ε I ≫ I.map f) (hs x)
      change _ ≫ I.map (_ ≫ _) = _ ≫ I.map (_ ≫ _) at h
      rw [I.map_comp, ← Category.assoc, I.map_comp, ← Category.assoc,
        Sheaf.ε_comp_constRingSheafSection, Category.assoc, Category.assoc] at h
      have hx := ConcreteCategory.congr_hom (congr_app h U) (ULift.up (1 : ℤ))
      let H (y : R) := ((toSheafify J _ ≫ (constRingSheafToCondensedRingObj V (B n)).hom).app U) y =
        ((toSheafify J _ ≫ (j.app _ ≫ pull.map c).hom).app U) y
      change H ((1 : ℤ) • x) at hx
      rwa [one_smul] at hx
    have hpoint : c ≫ k = D.map φ ≫ m ≫ p := by
      let adj := sheafificationAdjunction K Ab.{u + 1}
      let constR := (Functor.const Profinite.{u}ᵒᵖ).obj (AddCommGrpCat.of R)
      let constS := (Functor.const Profinite.{u}ᵒᵖ).obj (AddCommGrpCat.of S)
      have hc : toSheafify K constR ≫ c.hom = Profinite.constToContinuousMap (B n) := by
        let L := presheafToSheaf K Ab.{u + 1}
        let I := sheafToPresheaf K Ab.{u + 1}
        change adj.unit.app _ ≫ I.map (L.map (Profinite.constToContinuousMap (B n))) ≫
          I.map (adj.counit.app (Profinite.continuousMapRingObj.{u} (B n))) = _
        rw [← reassoc_of% (adj.unit.naturality (Profinite.constToContinuousMap (B n)))]
        exact (congrArg (fun z ↦ Profinite.constToContinuousMap (B n) ≫ z)
          (adj.right_triangle_components (Profinite.continuousMapRingObj.{u} (B n)))).trans
            (Category.comp_id _)
      have hφ : (Functor.const Profinite.{u}ᵒᵖ).map φ ≫ toSheafify K constS =
          toSheafify K constR ≫ (D.map φ).hom := toSheafify_naturality _ _
      have hm : toSheafify K constS ≫ m.hom =
          Functor.whiskerRight (toSheafify K
            ((Functor.const Profinite.{u}ᵒᵖ).obj (CommRingCat.of S))) F :=
        toSheafify_comp_constantCommuteCompose_inv_app_hom K S
      apply Sheaf.hom_ext
      apply sheafify_hom_ext K _ _ (abelianPoint S).property
      change toSheafify K constR ≫ c.hom ≫ k.hom =
        toSheafify K constR ≫ (D.map φ).hom ≫ m.hom ≫ p.hom
      rw [← Category.assoc, hc, ← Category.assoc, ← hφ, Category.assoc,
        ← Category.assoc (toSheafify K constS), hm]
      ext U x
      exact (ConcreteCategory.congr_hom (congr_app
        (toSheafify_naturality (J := K) (pointConstantsPresheaf S)) U) (d n x))
    change constRingSheafToCondensedRingObj V (B n) ≫ pull.map k =
      C.map φ ≫ (j.app _ ≫ pull.map (m ≫ p))
    have hj : C.map φ ≫ j.app _ = j.app _ ≫ pull.map (D.map φ) := j.naturality φ
    rw [hfac, Category.assoc, ← pull.map_comp, hpoint, pull.map_comp,
      ← Category.assoc, ← hj, Category.assoc]

end WeilII
