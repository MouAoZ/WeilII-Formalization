module

public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.Charts
public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.OfInvertible
public import WeilConjectures.AlgebraicGeometry.Modules.ZeroLocus
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme

/-!
# The family of affine hyperplanes

Zhang, *On an elementary proof of Weil II*, Theorem 2.4 and Construction 2.5, p. 3,
uses hyperplanes with equation `c + ∑ aᵢ zᵢ = 0`. In the dual projective space the
coordinate indexed by `none` is `c`, and the coordinates indexed by `some i` are
the linear coefficients. Katz, *Affine cohomological transforms*, Appendix A.1–A.5,
uses the corresponding projective incidence family.
-/

namespace WeilII

open AlgebraicGeometry CategoryTheory
open AlgebraicGeometry.ProjectiveSpace AlgebraicGeometry.Scheme.Modules

universe u

/-- The open of the dual projective space parametrizing affine hyperplanes in Zhang,
Theorem 2.4. It is the union of the charts where some linear coefficient is invertible. -/
@[expose] public noncomputable def affineHyperplaneParameter (I : Type u) (S : Scheme.{u}) :
    ℙ(Option I; S).Opens :=
  ⨆ i : I, standardOpen (Option I) S (some i)

/-- The homogeneous incidence equation of Zhang, Construction 2.5, evaluated at affine
coordinates `z` and projective coefficients given by `g`. It is a section of `g*𝒪(1)`. -/
@[expose] public noncomputable def affineHyperplaneSection {I : Type u} [Fintype I]
    {X S : Scheme.{u}} (g : X ⟶ ℙ(Option I; S)) (z : I → Γ(X, ⊤)) :
    Γ(twistRestrict g 1, ⊤) :=
  let a (j : Option I) : Γ(twistRestrict g 1, ⊤) :=
    pullbackSection g (twistOneSection (Option I) S j)
  a none + ∑ i, z i • a (some i)

/-- The affine equation in Zhang, Construction 2.5, normalized by a linear coefficient
`aᵢ`. Its coefficients are the coordinate ratios on the standard chart `D₊(aᵢ)`. -/
@[expose] public noncomputable def affineHyperplaneChartEquation {I : Type u} [Fintype I]
    {X S : Scheme.{u}} (g : X ⟶ ℙ(Option I; S)) (z : I → Γ(X, ⊤)) (i : I) :
    Γ(X, g ⁻¹ᵁ standardOpen (Option I) S (some i)) :=
  let D := standardOpen (Option I) S (some i)
  let ratio := fun j : Option I ↦ g.app D (coordRatio (Option I) S (some i) j)
  ratio none + ∑ j, X.presheaf.map (homOfLE le_top).op (z j) * ratio (some j)

/-- On the chart `aᵢ ≠ 0` of Zhang's hyperplane family (Theorem 2.4 and Construction 2.5),
the incidence section is `c/aᵢ + ∑ zⱼ (aⱼ/aᵢ)` times the generator `aᵢ`.
Restrict the sum to the chart and express each homogeneous coordinate in this generator. -/
public theorem affineHyperplaneSection_onChart {I : Type u} [Fintype I] {X S : Scheme.{u}}
    (g : X ⟶ ℙ(Option I; S)) (z : I → Γ(X, ⊤)) (i : I) :
    let D := standardOpen (Option I) S (some i)
    let res := homOfLE (le_top : g ⁻¹ᵁ D ≤ ⊤)
    (twistRestrict g 1).presheaf.map res.op (affineHyperplaneSection g z) =
      affineHyperplaneChartEquation g z i •
        (twistRestrict g 1).presheaf.map res.op
          (pullbackSection g (twistOneSection (Option I) S (some i))) := by
  dsimp only [affineHyperplaneChartEquation]
  let a (j : Option I) : Γ(twistRestrict g 1, ⊤) :=
    pullbackSection g (twistOneSection (Option I) S j)
  change (twistRestrict g 1).presheaf.map _ (a none + ∑ j, z j • a (some j)) = _
  rw [map_add, map_sum, add_smul, Finset.sum_smul]
  have coef (j : Option I) := pullbackSection_twistOneSection_map_eq_smul g j (some i)
  refine congrArg₂ (· + ·) (coef none) (Finset.sum_congr rfl fun j _ ↦ ?_)
  rw [Scheme.Modules.map_smul, mul_smul]
  exact congrArg (X.presheaf.map (homOfLE le_top).op (z j) • ·) (coef (some j))

/-- On any affine open of a linear-coefficient chart, the ideal of Zhang's incidence
scheme is generated by its normalized equation (Construction 2.5). On this open
`aᵢ` generates the pulled-back twisting line, so the ideal of the section is the
principal ideal of its coefficient in that generator. -/
public theorem affineHyperplaneIdeal_onChart {I : Type u} [Fintype I] {X S : Scheme.{u}}
    (g : X ⟶ ℙ(Option I; S)) (z : I → Γ(X, ⊤)) (i : I) (U : X.affineOpens)
    (hU : U.1 ≤ g ⁻¹ᵁ standardOpen (Option I) S (some i)) :
    (homOfGlobalSection _ (affineHyperplaneSection g z)).zeroLocus.ideal U =
      Ideal.span {X.presheaf.map (homOfLE hU).op (affineHyperplaneChartEquation g z i)} := by
  have : SheafOfModules.IsInvertible.{u, u, u} (Scheme.Modules.unit X) :=
    IsInvertible.sheafOfModules_isInvertible (MonoidalCategory.tensorUnit X.Modules)
  have := IsInvertible.sheafOfModules_isInvertible (twistRestrict g 1)
  refine Hom.ideal_zeroLocus _ U (isFreeGenerator_one _)
    ((isFreeGenerator_pullbackSection_twistOneSection g (some i)).map hU) ?_
  rw [homOfGlobalSection_app_one]
  have eqn := congrArg ((twistRestrict g 1).presheaf.map (homOfLE hU).op)
    (affineHyperplaneSection_onChart g z i)
  simp only [Scheme.Modules.map_smul, presheaf_map_homOfLE_map_homOfLE] at eqn
  exact eqn

/-- The ideal of the universal affine hyperplane of Zhang, Theorem 2.4. Its ambient
scheme is affine space over the parameter open. Its closed immersion is
`(affineHyperplaneFamily I S).subschemeι`. The chart formula above presents its ideal
locally by one equation. Changing generators of `𝒪(1)` multiplies it by a unit. -/
@[expose] public noncomputable def affineHyperplaneFamily (I : Type u) [Fintype I]
    (S : Scheme.{u}) : 𝔸(I; (affineHyperplaneParameter I S).toScheme).IdealSheafData :=
  let T := affineHyperplaneParameter I S
  let g := (𝔸(I; T.toScheme) ↘ T.toScheme) ≫ T.ι
  (homOfGlobalSection _ (affineHyperplaneSection g (AffineSpace.coord T.toScheme))).zeroLocus

/-- The scheme-theoretic inverse image `u⁻¹A` in Zhang, Theorem 2.4, for a parameter
`a` over `S`. The map to the universal family ambient space has affine coordinates
`uᵢ` and parameter obtained from `a` by base change to `X`. -/
@[expose] public noncomputable def affineHyperplaneInverseImage {I : Type u} [Fintype I]
    {X S : Scheme.{u}} (u : X ⟶ 𝔸(I; S)) (a : S ⟶ (affineHyperplaneParameter I S).toScheme)
    [a.IsOver S] : X.IdealSheafData :=
  let p := u ≫ (𝔸(I; S) ↘ S) ≫ a
  (affineHyperplaneFamily I S).comap
    (AffineSpace.homOfVector p (fun i ↦ u.appTop (AffineSpace.coord S i)))

end WeilII
