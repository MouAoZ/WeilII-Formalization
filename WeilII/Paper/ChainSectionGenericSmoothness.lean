module

public import WeilII.Paper.ChainSectionPolynomial
public import WeilII.Paper.SmoothAffineHypersurface
public import WeilConjectures.Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
import Mathlib.Algebra.MvPolynomial.Funext
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.MvPolynomial.EulerIdentity
import Mathlib.RingTheory.Spectrum.Prime.Topology
import WeilII.AlgebraicGeometry.HypersurfaceJacobian

/-!
# A principal open of smooth chain sections

Dingxin Zhang, *On an elementary proof of Weil II*, Construction 2.5, p. 3.
-/

open AlgebraicGeometry CategoryTheory

namespace WeilII

universe u

/-- In the normalized hyperplane chart of Zhang's Construction 2.5, a nonempty principal
open consists of parameters defining smooth chain hypersurfaces. The first `n` parameters
are the linear coefficients `a`, and the last is the constant `c`.

Proof. Write Q for the sum of products of adjacent variables and dᵢ for its partial
derivatives. Substitute (−d₁,…,−dₙ,Q) in the parameter ring. Its transcendence degree is
n+1, whereas the target polynomial ring has transcendence degree n. This substitution
therefore has a nonzero kernel element h. Since K is infinite, some tuple (a,c) has
h(a,c) ≠ 0, so the principal open D(h) has a K-point.

For any (a,c) in D(h), let J be generated by P = Q + ∑ aᵢXᵢ + c and its partial
derivatives. In the quotient by J we have aᵢ = −dᵢ and c = −Q + ∑ Xᵢdᵢ = Q by Euler's
identity for the homogeneous quadratic Q. The kernel relation now gives h(a,c) = 0 there.
This scalar is invertible, so J contains one. The coefficient of X₁X₂ in P is one since
n ≥ 2. Taking x₂ = 1 − a₁, all xᵢ for i > 2 zero, and x₁ = −a₂x₂ − c gives a zero of P.
Thus P is nonzero and a nonunit. The unit Jacobian ideal criterion gives a smooth
hypersurface for the closed immersion cut out by its global coordinate section. -/
public theorem exists_smooth_chainSection_basicOpen (K : Type u) [Field K] [IsAlgClosed K]
    (n : ℕ) (hn : 2 ≤ n) :
    ∃ h : MvPolynomial (Fin (n + 1)) K, h ≠ 0 ∧
      (∃ (a : Fin n → K) (c : K), MvPolynomial.eval (Fin.snoc a c) h ≠ 0) ∧
      ∀ (a : Fin n → K) (c : K), MvPolynomial.eval (Fin.snoc a c) h ≠ 0 →
        let S := Spec (CommRingCat.of K)
        let X := 𝔸(ULift.{u} (Fin n); S)
        let coeff := ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (X ↘ S).appTop).hom
        let p := MvPolynomial.eval₂Hom coeff (fun i : Fin n ↦ AffineSpace.coord S (ULift.up.{u} i))
          (chainSectionPolynomial a c)
        IsSmoothAffineHypersurface (X.zeroLocusSubschemeι {p}) := by
  classical
  let Q := chainSectionPolynomial (0 : Fin n → K) 0
  have hQ : Q.IsHomogeneous 2 := by
    cases n with
    | zero => simp [Q, chainSectionPolynomial, MvPolynomial.isHomogeneous_zero]
    | succ m =>
      simp only [Q, chainSectionPolynomial, Pi.zero_apply, map_zero, zero_mul,
        Finset.sum_const_zero, add_zero]
      exact MvPolynomial.IsHomogeneous.sum _ _ _ fun i _ ↦
        (MvPolynomial.isHomogeneous_X K i.castSucc).mul (MvPolynomial.isHomogeneous_X K i.succ)
  let critical : Fin (n + 1) → MvPolynomial (Fin n) K :=
    Fin.snoc (fun i : Fin n ↦ -MvPolynomial.pderiv i Q) Q
  let subst := MvPolynomial.aeval (R := K) critical
  have hker : ¬ Function.Injective subst := by
    intro hinj
    have hdim := trdeg_le_of_injective subst hinj
    simp [MvPolynomial.trdeg_of_isDomain] at hdim
  obtain ⟨f, g, heq, hne⟩ := Function.not_injective_iff.mp hker
  let h := f - g
  have hh : h ≠ 0 := sub_ne_zero.mpr hne
  have hrel : subst h = 0 := by simp [h, heq]
  refine ⟨h, hh, ?_, ?_⟩
  · have hex : ∃ x : Fin (n + 1) → K, MvPolynomial.eval x h ≠ 0 := by
      by_contra! hzero
      exact hh (MvPolynomial.funext fun x ↦ by simpa using hzero x)
    obtain ⟨x, hx⟩ := hex
    exact ⟨Fin.init x, x (Fin.last n), by simpa only [Fin.snoc_init_self] using hx⟩
  intro a c hac
  let P := chainSectionPolynomial a c
  have hvalues (t : K) : ∃ x : Fin n → K, MvPolynomial.eval x P = t := by
    obtain _ | _ | m := n
    · omega
    · omega
    · let x : Fin (m + 2) → K := Fin.cons (t - a 1 * (1 - a 0) - c)
        (Fin.cons (1 - a 0) (fun _ ↦ 0))
      refine ⟨x, ?_⟩
      simp [P, chainSectionPolynomial, x, Fin.sum_univ_succ, map_sum]
      ring
  apply isSmoothAffineHypersurface_of_unitJacobianIdeal hn P
  · obtain ⟨x, hx⟩ := hvalues 1
    intro hzero
    simp [hzero] at hx
  · obtain ⟨x, hx⟩ := hvalues 0
    intro hunit
    exact (hunit.map (MvPolynomial.eval x)).ne_zero hx
  let J := Ideal.span (insert P (Set.range fun i : Fin n ↦ MvPolynomial.pderiv i P))
  change J = ⊤
  by_contra hproper
  let B := MvPolynomial (Fin n) K ⧸ J
  have : Nontrivial B := Ideal.Quotient.nontrivial_iff.mpr hproper
  let q := Ideal.Quotient.mkₐ K J
  have hP : P = Q + (∑ i, MvPolynomial.C (a i) * MvPolynomial.X i) + MvPolynomial.C c := by
    cases n <;> simp [P, Q, chainSectionPolynomial]
  have hPzero : q P = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.subset_span (Set.mem_insert P _))
  have hd (i : Fin n) : q (-MvPolynomial.pderiv i Q) = algebraMap K B (a i) := by
    have hz : q (MvPolynomial.pderiv i P) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩))
    rw [hP] at hz
    simp [Pi.single_apply] at hz
    rw [map_neg]
    exact neg_eq_of_add_eq_zero_right hz
  have hc : q Q = algebraMap K B c := by
    have hs : (∑ i, algebraMap K B (a i) * q (MvPolynomial.X i)) = -q (2 • Q) := by
      rw [← hQ.sum_X_mul_pderiv, map_sum, ← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro i _
      rw [← hd, map_neg, map_mul]
      ring
    rw [hP, map_add, map_add, map_sum] at hPzero
    simp only [map_mul, MvPolynomial.algHom_C] at hPzero
    rw [hs, two_nsmul, map_add] at hPzero
    linear_combination -hPzero
  have compare : q.comp subst = (Algebra.ofId K B).comp (MvPolynomial.aeval (Fin.snoc a c)) := by
    apply MvPolynomial.algHom_ext
    intro i
    refine Fin.lastCases ?_ (fun j ↦ ?_) i
    · simpa [subst, critical] using hc
    · simpa [subst, critical] using hd j
  have hz := DFunLike.congr_fun compare h
  change q (subst h) = algebraMap K B (MvPolynomial.eval (Fin.snoc a c) h) at hz
  rw [hrel, map_zero] at hz
  exact hac ((algebraMap K B).injective (by simpa using hz.symm))

end WeilII
