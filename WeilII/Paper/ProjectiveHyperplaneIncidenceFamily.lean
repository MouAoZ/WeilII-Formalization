module

public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.Charts
public import WeilConjectures.AlgebraicGeometry.ProjectiveSpace.OfInvertible
public import WeilConjectures.AlgebraicGeometry.Modules.TensorSection
public import WeilConjectures.AlgebraicGeometry.Modules.ZeroLocus

/-!
# The universal projective hyperplane

Katz, *Affine cohomological transforms*, Appendix A, p. 218, uses the closed incidence
subscheme of projective space times its dual. In a basis and its dual basis the factors have
the same coordinate index type. The evaluation pairing is a section of the tensor product of
their two twisting lines. Its zero scheme specializes along any section of the dual space.
-/

namespace WeilII

open AlgebraicGeometry CategoryTheory Limits MonoidalCategory
open AlgebraicGeometry.ProjectiveSpace AlgebraicGeometry.Scheme.Modules

universe u

/-- The pairing of a point and a hyperplane in homogeneous coordinates, as in Katz,
Appendix A, p. 218. The two maps pull the respective coordinate sections to a common scheme. -/
@[expose] public noncomputable def projectiveHyperplaneIncidenceSection
    {I : Type u} [Fintype I] {S T : Scheme.{u}} (x y : T ⟶ ℙ(I; S)) :
    Γ(twistRestrict x 1 ⊗ twistRestrict y 1, ⊤) :=
  ∑ i : I, tmulSection (pullbackSection x (twistOneSection I S i))
    (pullbackSection y (twistOneSection I S i))

/-- The ideal of Katz's universal hyperplane (Appendix A, p. 218). Its `.subschemeι` is the
closed immersion into the product of projective space and its dual over the base. -/
@[expose] public noncomputable def projectiveHyperplaneIncidenceFamily
    (I : Type u) [Fintype I] (S : Scheme.{u}) :
    (Limits.pullback (ℙ(I; S) ↘ S) (ℙ(I; S) ↘ S)).IdealSheafData :=
  (homOfGlobalSection _ (projectiveHyperplaneIncidenceSection
    (pullback.fst (ℙ(I; S) ↘ S) (ℙ(I; S) ↘ S)) (pullback.snd _ _))).zeroLocus

/-- The hyperplane at a chosen parameter of Katz's dual projective space (Appendix A,
p. 218). Pulling this ideal back along `f : X ⟶ ℙ(I; S)` gives the ideal of `f⁻¹H`. -/
@[expose] public noncomputable def projectiveHyperplaneFiber {I : Type u} [Fintype I]
    {S : Scheme.{u}} (H : S ⟶ ℙ(I; S)) [H.IsOver S] : ℙ(I; S).IdealSheafData :=
  (projectiveHyperplaneIncidenceFamily I S).comap
    (pullback.lift (𝟙 _) ((ℙ(I; S) ↘ S) ≫ H) (by simp))

/-- In the chart of Katz, Appendix A.1, divide every coordinate by the chart generator.
The products of the two ratios are then the coefficients of the elementary tensors in the
frame `Xₐ ⊗ Y_b`. Summing gives the local equation of the pairing. -/
private theorem incidenceSection_chart {I : Type u} [Fintype I] {S T : Scheme.{u}}
    (x y : T ⟶ ℙ(I; S)) (a b : I) (W : T.Opens)
    (hx : W ≤ x ⁻¹ᵁ standardOpen I S a) (hy : W ≤ y ⁻¹ᵁ standardOpen I S b) :
    ∃ e : Γ(twistRestrict x 1 ⊗ twistRestrict y 1, W), IsFreeGenerator e ∧
      (homOfGlobalSection _ (projectiveHyperplaneIncidenceSection x y)).app W (1 : Γ(T, W)) =
        (∑ i : I, x.appLE _ W hx (coordRatio I S a i) *
          y.appLE _ W hy (coordRatio I S b i)) • e := by
  let coord (g : T ⟶ ℙ(I; S)) (i : I) := (twistRestrict g 1).presheaf.map
    (homOfLE (le_top : W ≤ ⊤)).op (pullbackSection g (twistOneSection I S i))
  have frame (g : T ⟶ ℙ(I; S)) (c : I) (h : W ≤ g ⁻¹ᵁ standardOpen I S c) :
      IsFreeGenerator (coord g c) := by
    exact (congrArg (IsFreeGenerator (M := twistRestrict g 1))
      (presheaf_map_homOfLE_map_homOfLE (M := twistRestrict g 1) le_top h
        (pullbackSection g (twistOneSection I S c)))).mp
          ((isFreeGenerator_pullbackSection_twistOneSection g c).map h)
  have ratio (g : T ⟶ ℙ(I; S)) (c i : I) (h : W ≤ g ⁻¹ᵁ standardOpen I S c) :
      coord g i = g.appLE _ W h (coordRatio I S c i) • coord g c :=
    presheaf_map_homOfLE_eq_smul _ h (pullbackSection_twistOneSection_map_eq_smul g i c)
  refine ⟨_, (frame x a hx).tmulSection (frame y b hy), ?_⟩
  rw [homOfGlobalSection_app_one, projectiveHyperplaneIncidenceSection, map_sum, Finset.sum_smul]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  refine (tmulSection_map (M := twistRestrict x 1) (N := twistRestrict y 1)
    (le_top : W ≤ ⊤) _ _).trans ?_
  change tmulSection (coord x i) (coord y i) = _
  rw [ratio x a i hx, ratio y b i hy, smul_tmulSection, tmulSection_smul, mul_smul]

/-- The ideal of the inverse image of Katz's incidence scheme on a pair of standard charts
(Appendix A.1, p. 218). Pull the two chart frames back to the test scheme. Their tensor
product generates the pairing line, so the local ideal is generated by the sum of the
products of the coordinate ratios. -/
public theorem projectiveHyperplaneIncidenceFamily_ideal {I : Type u} [Fintype I]
    {S T : Scheme.{u}} (x y : T ⟶ ℙ(I; S)) (h : x ≫ ℙ(I; S) ↘ S = y ≫ ℙ(I; S) ↘ S)
    (a b : I) (U : T.affineOpens)
    (hx : U.1 ≤ x ⁻¹ᵁ standardOpen I S a) (hy : U.1 ≤ y ⁻¹ᵁ standardOpen I S b) :
    ((projectiveHyperplaneIncidenceFamily I S).comap (pullback.lift x y h)).ideal U =
      Ideal.span {(∑ i : I, x.appLE _ U.1 hx (coordRatio I S a i) *
        y.appLE _ U.1 hy (coordRatio I S b i))} := by
  let p := ℙ(I; S) ↘ S
  let Q := Limits.pullback p p
  let p₁ : Q ⟶ ℙ(I; S) := pullback.fst p p
  let p₂ : Q ⟶ ℙ(I; S) := pullback.snd p p
  let q : T ⟶ Q := pullback.lift x y h
  let W := p₁ ⁻¹ᵁ standardOpen I S a ⊓ p₂ ⁻¹ᵁ standardOpen I S b
  have hU : U.1 ≤ q ⁻¹ᵁ W := by
    simpa only [W, Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage, q, p₁, p₂,
      pullback.lift_fst, pullback.lift_snd, le_inf_iff] using And.intro hx hy
  let L := twistRestrict p₁ 1 ⊗ twistRestrict p₂ 1
  let φ := homOfGlobalSection L (projectiveHyperplaneIncidenceSection p₁ p₂)
  have h₁ : SheafOfModules.IsInvertible.{u, u, u} (Scheme.Modules.unit Q) :=
    IsInvertible.sheafOfModules_isInvertible (𝟙_ Q.Modules)
  have hL : SheafOfModules.IsInvertible.{u, u, u} L := IsInvertible.sheafOfModules_isInvertible L
  have := SheafOfModules.IsInvertible.pullback (g := q) h₁
  have := SheafOfModules.IsInvertible.pullback (g := q) hL
  obtain ⟨e, he, hc⟩ := incidenceSection_chart p₁ p₂ a b W inf_le_left inf_le_right
  obtain ⟨_, _, hM, hN, hc'⟩ := IsFreeGenerator.exists_pullback q φ (isFreeGenerator_one W) he hc
  change (φ.zeroLocus.comap q).ideal U = _
  rw [Hom.comap_zeroLocus, Hom.ideal_zeroLocus _ U (hM.map hU) (hN.map hU)
    (Hom.app_presheaf_map_of_eq _ (homOfLE hU) hc')]
  congr 2
  change q.appLE W U.1 hU _ = _
  simp only [map_sum, map_mul, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE,
    q, p₁, p₂, pullback.lift_fst, pullback.lift_snd]

/-- At a parameter in the chart `Y_b ≠ 0`, the fiber ideal on `Xₐ ≠ 0` is generated by
`∑ᵢ (Xᵢ/Xₐ)(yᵢ/y_b)`, as in Katz, Appendix A, p. 218. Apply the incidence chart formula
to the graph of the parameter and compose the pullbacks of the dual coordinate ratios. -/
public theorem projectiveHyperplaneFiber_ideal {I : Type u} [Fintype I] {S : Scheme.{u}}
    (H : S ⟶ ℙ(I; S)) [H.IsOver S] (a b : I) (hb : ⊤ ≤ H ⁻¹ᵁ standardOpen I S b)
    (U : ℙ(I; S).affineOpens) (ha : U.1 ≤ standardOpen I S a) :
    (projectiveHyperplaneFiber H).ideal U =
      Ideal.span {(∑ i : I, ℙ(I; S).presheaf.map (homOfLE ha).op (coordRatio I S a i) *
        (ℙ(I; S) ↘ S).appLE ⊤ U.1 le_top (H.appLE _ ⊤ hb (coordRatio I S b i)))} := by
  let p := ℙ(I; S) ↘ S
  have hy : U.1 ≤ (p ≫ H) ⁻¹ᵁ standardOpen I S b := le_top.trans (p.preimage_mono hb)
  refine (projectiveHyperplaneIncidenceFamily_ideal (𝟙 _) (p ≫ H) (by simp [p])
    a b U ha hy).trans ?_
  congr 2
  apply Finset.sum_congr rfl
  intro i _
  refine congrArg₂ (· * ·) rfl ?_
  exact congrArg (fun f ↦ CommRingCat.Hom.hom f (coordRatio I S b i))
    (Scheme.Hom.appLE_comp_appLE p H _ ⊤ U.1 hb le_top).symm

end WeilII
